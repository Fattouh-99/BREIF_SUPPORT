declare const hypertuneAdapter: <TFlagValues extends Record<string, unknown>, TContext extends Record<string, unknown>>({ createSource, flagFallbacks, flagDefinitions, identify, createSourceOptions, }: AdapterArgs<TFlagValues, TContext>) => {
    declarations: { [key in keyof TFlagValues]: FlagDeclaration<TFlagValues[key], TContext>; };
    getSource: () => ReturnType<typeof createSource>;
};

export { createHypertuneAdapter, hypertuneAdapter };
